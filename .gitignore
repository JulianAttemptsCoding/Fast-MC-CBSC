# Office lock files (`~$name.ext` beside an open document). Transient and
# unreadable while the app holds it; one was swept into a commit via
# `git add -A` on 2026-08-05 while PowerPoint had a bundled deck open, which
# is exactly what this entry exists to prevent from recurring.
~$*

# Python caches and local test output
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
coverage.json

# Local environments and secrets
.venv/
venv/
.env
.env.*
*.pem
*.key
*.p12
*credentials*.json
*service-account*.json

# Raw detector data and model checkpoints stay in controlled storage
*.root
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.parquet
*.arrow

# Sole exception: a tiny, generator-backed synthetic schema test fixture.
!/fixtures/outfile_neutron1_schema_fixture.root

# Downloaded Vertex output trees; retain the compact top-level audit summaries
/audit/*/

# Generated dashboard payloads and runtime output
/dashboard/public/data/*.json
!/dashboard/public/data/geometry.json
!/dashboard/public/data/manifest.json
/dashboard/site_*.log
/dashboard/site_*.err
/dashboard/vertex_sync*.log
/dashboard/vertex_sync*.err.log

# JavaScript dependencies and generated bundles
/dashboard/node_modules/
/dashboard/dist/
/dashboard/.vinext/
/dashboard/.next/
/dashboard/.wrangler/
/dashboard/outputs/
/dashboard/work/

# OS and editor metadata
.DS_Store
Thumbs.db
*.swp
*~

# Local credential notes. Pod tokens are access to the shared filesystem, so
# they must never be tracked. Anything matching these stays on the machine.
/POD_ACCESS.local.md
*.local.md
*.secrets

# Campaign refresh working directory (pulled from the pod, never authoritative)
/.campaign_scratch/

# watch_campaign_outputs.py runtime state: lock file, heartbeat log, stop
# sentinel, and last-known evidence snapshot. All local-only and regenerated.
/_watch/
